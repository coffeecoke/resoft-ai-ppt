# 复制为 .env 后按需填写。勿将真实密钥提交到 Git。

# ========== 讯飞转录 · 音频时长（Python service.py）==========
# 入库 audio_duration 优先用 ffprobe 读文件实际时长（与讯飞对白时间戳无关）；需本机 PATH 可执行 ffprobe（一般随 ffmpeg 安装）
# 自定义路径（可选，与 Node 侧 FFMPEG_PATH 类似）：
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# ========== 讯飞转录 · 本地结果落盘（Python xfyun_client）==========
# 未设置时默认写入 <ai_backend>/data/xunfei_transcripts（Mac/Linux/Windows 均可）
# XUNFEI_TRANSCRIPT_OUTPUT_DIR=/your/custom/path
# Windows 且音频文件在 E: 盘时，TXT 默认写入 E:\已转录；可单独覆盖：
# XUNFEI_TRANSCRIPT_E_DRIVE_OUTPUT_DIR=E:\已转录

# ========== 企业微信智能机器人（WebSocket，角色确认发卡片等）==========
# 同一 botId 全局只能一条长连接；被其它进程/环境挤下线后，默认约 8s 后自动重连（可调）
# WECOM_KICKED_RECONNECT_DELAY_MS=8000

# ========== 企业微信自建应用（推送视频：appchat 建群）==========
# 与「智能机器人」WECOM_BOT_ID / WECOM_BOT_SECRET 不是同一套凭证。
# 企业 ID：管理后台 → 我的企业 → 企业信息（通常以 ww 开头）
WECOM_CORP_ID=
# 自建应用 Secret（与下方 AgentId 对应应用的 Secret）
WECOM_APPCHAT_SECRET=
# 可选：应用详情页 AgentId，便于对照文档（appchat 接口不强制读取）
WECOM_AGENT_ID=
# 可选：该应用「接收消息」回调的 Token / EncodingAESKey（与 gettoken 无关）
WECOM_CUSTOM_APP_TOKEN=
WECOM_CUSTOM_APP_ENCODING_AES_KEY=

# ========== 售前报备 HTTP 接入（report-and-transcribe）==========
# 留空则不鉴权（仅联调）；生产请设为强随机串，并在请求头携带 X-Presales-Inbound-Secret 或 Authorization: Bearer
PRESALES_INBOUND_API_SECRET=
# 入站音频落盘目录（可选，默认：<UPLOAD_BASE_DIR>/presales_inbound/audio）
# PRESALES_INBOUND_AUDIO_DIR=
# 单文件最大字节（可选，默认 500MB，与转录上传限制一致）
# PRESALES_INBOUND_AUDIO_MAX_BYTES=524288000

# ========== 售前视频 · 角色确认重复提醒（企微 Markdown）==========
# 流水线长期处于「角色确认中」时，按固定间隔向接收人重复提醒，直至对方确认（重新发卡片会重置计时）
# PRESALES_VIDEO_ROLE_CONFIRM_REMINDER_DISABLED=false
# 提醒间隔（分钟）：发卡片后满该时间发第 1 条，之后每隔该时间再发（默认 30）
# PRESALES_VIDEO_ROLE_CONFIRM_REMINDER_INTERVAL_MINUTES=30
# 兼容旧名（与 INTERVAL 二选一即可，优先 INTERVAL）
# PRESALES_VIDEO_ROLE_CONFIRM_REMINDER_AFTER_MINUTES=30
# 扫描间隔（毫秒），默认 120000（建议小于 INTERVAL，否则提醒会偏晚）
# PRESALES_VIDEO_ROLE_CONFIRM_REMINDER_SCAN_MS=120000
# 自定义正文（可选，不配则用默认话术）
# PRESALES_VIDEO_ROLE_CONFIRM_REMINDER_TEXT=

# ========== 售前视频 · 服务端自动流水线（方案 B，不依赖页面常开）==========
# 设为 true 则不在进程内注册定时轮询（仍可 POST /api/presales-video/pipeline-runs/start 入队，但不会自动推进）
# PRESALES_VIDEO_PIPELINE_DISABLED=false
# 轮询间隔（毫秒），默认 30000，最小 5000
# PRESALES_VIDEO_PIPELINE_TICK_MS=30000
# 回环调用本机 API 的基址（默认 http://127.0.0.1:$PORT）；多实例/反代特殊部署时可改
# PRESALES_VIDEO_PIPELINE_INTERNAL_BASE_URL=
# 启动流水线时若未传 pushVideoUserIds，则使用该默认值（企微 userid 逗号分隔，至少 2 人规则仍由推送视频接口校验）
# PRESALES_VIDEO_PIPELINE_DEFAULT_PUSH_VIDEO_USERIDS=
