{
  "name": "document-text-extractor",
  "version": "1.0.0",
  "description": "文档文本提取器 - Web版",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "test": "node scripts/test-extractor.js",
    "batch": "node scripts/batch-extract.js",
    "import-bidding": "node scripts/import-bidding-keyword-exports.js",
    "resume-extract": "python python_services/resume_split/resume_split_extract.py",
    "resume-import": "node scripts/import-bid-resume-records.js --latest",
    "resume-probe-docx": "python python_services/resume_split/resume_split_extract.py --probe-docx",
    "resume-batch-root": "node scripts/run-resume-batch-root.js"
  },
  "keywords": [
    "document",
    "extractor",
    "text",
    "json",
    "ppt"
  ],
  "author": "AI Assistant",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@wecom/aibot-node-sdk": "^1.0.4",
    "codemirror": "^5.65.17",
    "docx": "^9.6.0",
    "docx-preview": "^0.3.7",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "form-data": "^4.0.5",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.1",
    "multer": "^2.0.2",
    "openai": "^4.24.0",
    "pdf-parse": "^2.4.5",
    "uuid": "^13.0.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
