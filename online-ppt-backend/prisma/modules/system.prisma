// ==================== 系统配置相关表 ====================

/// 提示词模板表
model prompt_templates {
  id          String   @id @db.VarChar(50) /// 模板ID
  name        String   @db.VarChar(100) /// 模板名称
  code        String   @unique @db.VarChar(100) /// 模板代码（唯一）
  type        String   @db.VarChar(50) /// 模板类型
  description String?  @db.Text /// 模板描述
  prompt      String   @db.Text /// 提示词内容
  is_active   Boolean  @default(true) /// 是否启用
  sort_order  Int      @default(0) /// 排序字段
  created_at  DateTime @default(now()) /// 创建时间
  updated_at  DateTime @updatedAt /// 更新时间

  // 🆕 AI后台管理扩展字段
  variables  Json? /// 动态变量定义（JSON数组）
  version    String  @default("1.0") @db.VarChar(20) /// 版本号
  scene_type String? @db.VarChar(50) /// 关联场景类型（transcription, ppt_analysis等）

  @@index([type], map: "idx_type")
  @@index([code], map: "idx_code")
  @@index([is_active], map: "idx_is_active")
  @@index([scene_type], map: "idx_scene_type")
  @@index([version], map: "idx_version")
}

/// AI模型配置表（统一管理所有AI功能使用的模型）
model ai_model_configs {
  // 基础信息
  id   String @id @db.VarChar(50) /// 配置ID
  name String @db.VarChar(100) /// 模型显示名称（如"讯飞星火V3.5"）
  code String @unique @db.VarChar(100) /// 模型代码（唯一标识）

  // 模型提供商信息
  provider   String @db.VarChar(50) /// 提供商代码（xfyun, openai, qwen等）
  model_name String @db.VarChar(100) /// 实际调用的模型名称

  // API配置
  api_url    String  @db.VarChar(500) /// API地址
  api_key    String  @db.VarChar(500) /// API密钥
  api_secret String? @db.VarChar(500) /// API密钥2（部分厂商需要）

  // 模型参数
  max_tokens  Int    @default(2000) /// 最大Token数
  temperature Float  @default(0.7) /// 温度参数（0-2）
  top_p       Float? @default(0.9) /// 核采样参数

  // 功能场景配置
  scene_type String  @db.VarChar(50) /// 使用场景（transcription, ppt_analysis等）
  is_default Boolean @default(false) /// 是否为该场景的默认模型

  // 扩展配置
  extra_config Json? /// 额外配置（JSON格式）

  // 能力标记
  supports_stream    Boolean @default(true) /// 是否支持流式输出
  supports_functions Boolean @default(false) /// 是否支持函数调用
  supports_vision    Boolean @default(false) /// 是否支持图像识别

  // 成本统计
  cost_per_1k_tokens Decimal? @db.Decimal(10, 6) /// 每1K tokens的成本（元）
  total_calls        Int      @default(0) /// 累计调用次数
  total_tokens       BigInt   @default(0) /// 累计消耗tokens

  // 状态管理
  is_active     Boolean   @default(true) /// 是否启用
  is_available  Boolean   @default(true) /// 是否可用
  last_check_at DateTime? /// 最后检测时间
  error_count   Int       @default(0) /// 连续错误次数

  // 显示排序
  sort_order Int @default(0) /// 排序字段

  // 审计字段
  created_at DateTime @default(now()) /// 创建时间
  updated_at DateTime @updatedAt /// 更新时间
  created_by String?  @db.VarChar(50) /// 创建人ID

  // 备注
  remark String? @db.Text /// 备注说明

  @@index([scene_type], map: "idx_scene_type")
  @@index([is_default, scene_type], map: "idx_default_scene")
  @@index([is_active], map: "idx_is_active")
  @@index([provider], map: "idx_provider")
  @@index([sort_order], map: "idx_sort_order")
}

// ==================== 系统管理相关表 ====================

/// 字典类型表
model dict_types {
  id         String      @id @db.VarChar(50) /// 字典类型ID
  dict_type  String      @unique @db.VarChar(100) /// 字典类型代码（唯一）
  dict_name  String      @db.VarChar(255) /// 字典类型名称
  status     String      @default("0") @db.VarChar(1) /// 状态：0=正常，1=停用
  remark     String?     @db.VarChar(500) /// 备注
  sort_order Int         @default(0) /// 排序字段
  created_at DateTime    @default(now()) /// 创建时间
  updated_at DateTime    @updatedAt /// 更新时间
  dict_data  dict_data[] /// 关联字典数据

  @@index([dict_type], map: "idx_dict_type")
  @@index([status], map: "idx_status")
}

/// 字典数据表
model dict_data {
  id         String     @id @db.VarChar(50) /// 字典数据ID
  dict_type  String     @db.VarChar(100) /// 字典类型代码
  dict_label String     @db.VarChar(255) /// 字典标签（显示名称）
  dict_value String     @db.VarChar(255) /// 字典值
  dict_sort  Int        @default(0) /// 排序字段
  css_class  String?    @db.VarChar(100) /// CSS类名（用于样式）
  list_class String?    @db.VarChar(100) /// 列表样式类
  is_default String     @default("N") @db.VarChar(1) /// 是否默认：Y=是，N=否
  status     String     @default("0") @db.VarChar(1) /// 状态：0=正常，1=停用
  remark     String?    @db.VarChar(500) /// 备注
  created_at DateTime   @default(now()) /// 创建时间
  updated_at DateTime   @updatedAt /// 更新时间
  dict_types dict_types @relation(fields: [dict_type], references: [dict_type], onDelete: Cascade)

  @@unique([dict_type, dict_value], map: "uk_dict_type_value")
  @@index([dict_type], map: "idx_dict_type")
  @@index([dict_value], map: "idx_dict_value")
  @@index([status], map: "idx_status")
}

// ==================== 文件扫描相关表 ====================

/// 文件扫描历史记录表
model file_scan_history {
  id             String    @id @db.VarChar(50) /// 记录ID
  file_path      String    @unique @db.VarChar(500) /// 文件完整路径（唯一索引）
  file_name      String    @db.VarChar(255) /// 文件名
  file_size      BigInt    @default(0) /// 文件大小（字节）
  file_type      String    @db.VarChar(20) /// 文件类型（.pptx, .docx, .pdf）
  modified_time  DateTime /// 文件修改时间
  processed_time DateTime? /// 处理时间
  document_id    String?   @db.VarChar(50) /// 生成的文档ID
  status         String    @default("pending") @db.VarChar(20) /// 状态：pending=待处理，processing=处理中，success=成功，failed=失败
  error_message  String?   @db.Text /// 错误信息（失败时）
  scan_time      DateTime /// 扫描时间
  created_at     DateTime  @default(now()) /// 创建时间
  updated_at     DateTime  @updatedAt /// 更新时间

  @@index([status], map: "idx_status")
  @@index([processed_time], map: "idx_processed_time")
  @@index([scan_time], map: "idx_scan_time")
  @@index([file_type], map: "idx_file_type")
}

// ==================== PPT模版相关表 ====================

/// PPT模版表
model templates {
  id                String   @id @db.VarChar(50)          /// 模版ID，如 template_1
  name              String   @db.VarChar(255)              /// 模版名称
  cover             String?  @db.VarChar(500)              /// 封面图URL（文件路径）
  category          String   @default("official") @db.VarChar(50)  /// 分类：official=官方，community=社区，user=用户
  origin            String?  @db.VarChar(255)              /// 来源描述
  status            String   @default("draft") @db.VarChar(20)     /// 状态：draft=草稿，published=已发布，archived=已归档
  slide_count       Int      @default(0)                   /// 幻灯片页数
  content_file_path String   @db.VarChar(500)              /// 内容JSON文件路径（与 documents 表设计一致）

  // 审计字段
  created_by  String?  @db.VarChar(50)   /// 创建人用户ID（内置模版为 null）
  updated_by  String?  @db.VarChar(50)   /// 最后修改人用户ID
  created_at  DateTime @default(now())   /// 创建时间
  updated_at  DateTime @updatedAt        /// 更新时间（自动更新）

  @@index([status],     map: "idx_templates_status")
  @@index([category],   map: "idx_templates_category")
  @@index([created_by], map: "idx_templates_created_by")
  @@index([created_at], map: "idx_templates_created_at")
}
