// ==================== 招投标文件分析相关表 ====================

/// 招标文件表（存储上传的招标文件及AI分析结果）
model tender_documents {
  id              String  @id @db.VarChar(50)
  name            String  @db.VarChar(255) /// 文件名称
  file_path       String  @db.VarChar(500) /// 原始文件存储路径
  file_type       String  @db.VarChar(20) /// 文件类型（pdf, docx, doc）
  file_size       BigInt  @default(0) /// 文件大小（字节）
  raw_text        String? @db.LongText /// 提取的纯文本内容（用于AI分析）
  raw_html_path   String? @db.VarChar(500) /// HTML文件路径（保留表格/图片结构，存磁盘不入库）
  analysis_result Json?   /// AI分析结果（评分标准、资质要求、技术要求等）
  directory_json  Json?   /// 生成的投标目录结构（JSON树）
  status          String  @default("uploaded") @db.VarChar(20) /// uploaded=已上传, extracting=提取中, analyzing=分析中, completed=已完成, failed=失败
  error_message   String? @db.Text /// 错误信息
  model_name      String? @db.VarChar(100) /// 使用的AI模型
  project_name    String? @db.VarChar(255) /// 招标项目名称（AI提取）
  bid_deadline    String? @db.VarChar(100) /// 投标截止时间（AI提取）
  budget          String? @db.VarChar(100) /// 预算金额（AI提取）
  created_by      String? @db.VarChar(50) /// 创建人ID
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  bid_directory_items bid_directory_items[]
  bid_compositions    bid_compositions[]
  tender_sections     tender_sections[]

  @@index([status], map: "idx_tender_status")
  @@index([created_by], map: "idx_tender_created_by")
  @@index([created_at], map: "idx_tender_created_at")
}

/// 招标文件章节表（从招标文件 docx 解析出的目录章节，供前端 TOC 展示和章节勾选）
model tender_sections {
  id                String   @id @db.VarChar(50)
  tender_id         String   @db.VarChar(50)  /// 关联 tender_documents.id
  title             String   @db.VarChar(500) /// 章节标题文本
  level             Int      @default(1)      /// 层级（1=章, 2=节, 3=小节）
  sort_order        Int      @default(0)      /// 排序
  parent_section_id String?  @db.VarChar(50) /// 父章节ID（支持树形结构，null 表示顶级）
  created_at        DateTime @default(now())

  tender_documents tender_documents   @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  parent           tender_sections?   @relation("tender_section_hierarchy", fields: [parent_section_id], references: [id], onDelete: Restrict)
  children         tender_sections[]  @relation("tender_section_hierarchy")

  @@index([tender_id], map: "idx_tendersec_tender_id")
  @@index([parent_section_id], map: "idx_tendersec_parent_id")
  @@index([sort_order], map: "idx_tendersec_sort_order")
}

/// 投标目录项（根据招标文件AI生成的投标文件目录树）
model bid_directory_items {
  id              String  @id @db.VarChar(50)
  tender_id       String  @db.VarChar(50) /// 关联招标文件ID
  parent_id       String? @db.VarChar(50) /// 父目录ID（支持层级）
  title           String  @db.VarChar(500) /// 目录标题
  level           Int     @default(1) /// 层级（1=章, 2=节, 3=小节）
  sort_order      Int     @default(0) /// 排序
  default_content      String? @db.LongText /// AI生成的默认文本内容
  default_html_content String? @db.LongText /// AI生成的默认HTML内容（含表格）- 仅用于小片段，大内容走文件
  user_content         String? @db.LongText /// 用户编辑后的内容
  content_status  String  @default("empty") @db.VarChar(20) /// empty=空, ai_generated=AI已生成, user_edited=用户已编辑
  section_type    String? @db.VarChar(50) /// 章节类型（cover_letter, technical_solution等）
  scoring_weight  Float?  /// 评分权重（从招标文件提取）
  docx_file_path  String? @db.VarChar(500) /// 该章节对应的 .docx 片段路径
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tender_documents tender_documents @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  parent           bid_directory_items?  @relation("bid_directory_hierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children         bid_directory_items[] @relation("bid_directory_hierarchy")

  @@index([tender_id], map: "idx_biddir_tender_id")
  @@index([parent_id], map: "idx_biddir_parent_id")
  @@index([level], map: "idx_biddir_level")
  @@index([sort_order], map: "idx_biddir_sort_order")
}

/// 投标文件表（存储上传的已有投标文件，用于拆分复用）
model bid_documents {
  id           String  @id @db.VarChar(50)
  name         String  @db.VarChar(255) /// 文件名称
  file_path    String  @db.VarChar(500) /// 原始文件存储路径
  file_type    String  @db.VarChar(20) /// 文件类型
  file_size    BigInt  @default(0) /// 文件大小（字节）
  raw_text     String? @db.LongText /// 提取的纯文本（用于AI分析）
  raw_html_path String? @db.VarChar(500) /// HTML文件路径（保留表格/图片，存磁盘不入库）
  status       String  @default("uploaded") @db.VarChar(20) /// uploaded=已上传, extracting=提取中, splitting=拆分中, completed=已完成, failed=失败
  error_message String? @db.Text /// 错误信息
  model_name   String? @db.VarChar(100) /// 使用的AI模型
  section_count Int    @default(0) /// 拆分出的章节数
  source_info  String? @db.VarChar(255) /// 来源信息（哪个项目/客户的投标）
  industry     String? @db.VarChar(100) /// 行业
  project_type String? @db.VarChar(100) /// 项目类型（IT、工程、咨询等）
  created_by   String? @db.VarChar(50)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  bid_sections bid_sections[]

  @@index([status], map: "idx_biddoc_status")
  @@index([industry], map: "idx_biddoc_industry")
  @@index([project_type], map: "idx_biddoc_project_type")
  @@index([created_by], map: "idx_biddoc_created_by")
  @@index([created_at], map: "idx_biddoc_created_at")
}

/// 投标章节表（投标文件拆分后的独立章节，可复用）
model bid_sections {
  id              String  @id @db.VarChar(50)
  bid_document_id String  @db.VarChar(50) /// 关联投标文件ID
  title           String  @db.VarChar(500) /// 章节标题
  content         String? @db.LongText /// 章节纯文本内容（用于AI分析和全文搜索）
  html_content_path String? @db.VarChar(500) /// 章节HTML文件路径（保留表格/图片，存磁盘不入库）
  content_length  Int     @default(0) /// 内容长度
  section_type    String  @default("other") @db.VarChar(50) /// 章节类型
  level           Int     @default(1) /// 章节层级
  sort_order      Int     @default(0) /// 排序
  tags            Json?   /// 标签（JSON数组，用于检索）
  quality_score   Float?  /// AI评估的质量分数（0-1）
  is_reusable     Boolean @default(true) /// 是否可复用
  docx_file_path  String? @db.VarChar(500) /// 拆分出的 .docx 片段路径
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
   parent_section_id String? @db.VarChar(50) /// ???ID?1????null?2?????1??

  bid_documents          bid_documents           @relation(fields: [bid_document_id], references: [id], onDelete: Cascade)
  bid_composition_items  bid_composition_items[]

  @@index([bid_document_id], map: "idx_bidsec_document_id")
  @@index([section_type], map: "idx_bidsec_type")
  @@index([is_reusable], map: "idx_bidsec_reusable")
  @@index([parent_section_id], map: "idx_bidsec_parent_id")
  @@index([quality_score], map: "idx_bidsec_quality")
  @@fulltext([content], map: "ft_bidsec_content")
  @@fulltext([title], map: "ft_bidsec_title")
}

/// 投标组合表（用户基于招标目录组合的投标文件）
model bid_compositions {
  id          String  @id @db.VarChar(50)
  name        String  @db.VarChar(255) /// 组合名称
  tender_id   String? @db.VarChar(50) /// 关联的招标文件ID（可选）
  description String? @db.Text /// 描述
  status      String  @default("draft") @db.VarChar(20) /// draft=草稿, completed=已完成, exported=已导出
  docx_file_path String? @db.VarChar(500) /// 合并后的完整 .docx 路径
  template_name  String? @db.VarChar(255) /// 使用的模板名称
  created_by  String? @db.VarChar(50)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tender_documents      tender_documents?       @relation(fields: [tender_id], references: [id])
  bid_composition_items bid_composition_items[]

  @@index([tender_id], map: "idx_bidcomp_tender_id")
  @@index([status], map: "idx_bidcomp_status")
  @@index([created_by], map: "idx_bidcomp_created_by")
  @@index([created_at], map: "idx_bidcomp_created_at")
}

/// 投标组合明细（组合中引用的章节）
model bid_composition_items {
  id             String  @id @db.VarChar(50)
  composition_id String  @db.VarChar(50) /// 关联组合ID
  section_id     String? @db.VarChar(50) /// 引用的章节ID（从章节库选择时）
  title          String  @db.VarChar(500) /// 章节标题
  custom_content String? @db.LongText /// 自定义/编辑后的内容
  sort_order     Int     @default(0) /// 排序
  level          Int     @default(1) /// 章节层级
  source_type    String  @default("custom") @db.VarChar(20) /// custom=手写, reference=引用章节, ai_generated=AI生成
  docx_file_path String? @db.VarChar(500) /// 该项对应的 .docx 片段路径
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  bid_compositions bid_compositions @relation(fields: [composition_id], references: [id], onDelete: Cascade)
  bid_sections     bid_sections?    @relation(fields: [section_id], references: [id])

  @@index([composition_id], map: "idx_bidcompitem_comp_id")
  @@index([section_id], map: "idx_bidcompitem_sec_id")
  @@index([sort_order], map: "idx_bidcompitem_sort")
}

/// 投标章节类型表（技术方案、商务条款等）
model bid_section_types {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)  /// 类型编码，如 technical_solution
  name        String   @db.VarChar(100)         /// 显示名称
  description String   @db.VarChar(500)         /// 描述，用于 AI Prompt
  sort_order  Int      @default(0)              /// 排序序号
  is_active   Boolean  @default(true)           /// 是否启用
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([is_active], map: "idx_bidsectype_active")
  @@index([sort_order], map: "idx_bidsectype_sort")
}

/// 投标文件「人员简历」独立拆分抽取结果（与 bid_sections 并存，专用于简历库）
model bid_resume_records {
  id                   String   @id @db.VarChar(50)
  run_batch_id         String?  @db.VarChar(50) /// 同一次脚本运行批次（manifest.batch_id）
  source_docx_path     String   @db.VarChar(800) /// 原始 docx 路径（可存绝对路径便于追溯）
  source_docx_basename String   @db.VarChar(255) /// 原始文件名
  /// 源文件操作系统修改时间（区分同人简历在不同版本文档中的重复）
  source_docx_modified_at DateTime?
  h1_section_title     String   @db.VarChar(500) /// 一级章节标题
  l2_section_title     String?  @db.VarChar(500) /// 二级切片标题（单人块）
  person_name          String?  @db.VarChar(100)
  role_title           String?  @db.VarChar(200)
  raw_text             String?  @db.LongText
  extracted_json       Json?    /// 规则抽取字段，可扩展为 AI 结果
  split_docx_path      String?  @db.VarChar(500) /// 切片 docx 绝对或相对路径
  manifest_path        String?  @db.VarChar(800) /// 本次 manifest.json 路径
  created_at           DateTime @default(now())

  bid_resume_persons              bid_resume_persons[]
  bid_resume_person_canonicals    bid_resume_person_canonical[]

  @@index([run_batch_id], map: "idx_bidresume_batch")
  @@index([source_docx_basename], map: "idx_bidresume_srcbase")
  @@index([person_name], map: "idx_bidresume_person")
  @@index([source_docx_modified_at], map: "idx_bidresume_src_mtime")
  @@index([created_at], map: "idx_bidresume_created")
}

/// 从章节级简历文本中再拆出的「单人」结构化记录
model bid_resume_persons {
  id                    String   @id @db.VarChar(50)
  resume_record_id      String?  @db.VarChar(50) /// 关联 bid_resume_records.id（入库时写入）
  run_batch_id          String?  @db.VarChar(50)
  source_docx_basename  String   @db.VarChar(255)
  /// 与 bid_resume_records 一致，便于按人+文档版本查询
  source_docx_modified_at DateTime?
  h1_section_title      String   @db.VarChar(500)
  l2_section_title      String?  @db.VarChar(500)
  sort_order            Int      @default(0)
  role_label            String?  @db.VarChar(120) /// 如 项目总监、开发工程师（来自「角色-姓名」行）
  person_name           String?  @db.VarChar(80)
  gender                String?  @db.VarChar(20)
  age                   String?  @db.VarChar(32)
  education_level       String?  @db.VarChar(80) /// 学历
  major                 String?  @db.VarChar(200)
  graduate_school       String?  @db.VarChar(200)
  work_years_hint       String?  @db.VarChar(64)
  /// 表格「工作时间」等（如 12 年），可与 work_years_hint 并存
  work_duration_text    String?  @db.VarChar(64)
  phone                 String?  @db.VarChar(50)
  email                 String?  @db.VarChar(120)
  id_card               String?  @db.VarChar(24) /// 身份证号码（脱敏或完整）
  degree                String?  @db.VarChar(40) /// 学位
  employer              String?  @db.VarChar(200) /// 现所在单位
  proposed_project_role String?  @db.VarChar(120) /// 拟在本项目担任职务
  project_experience    String?  @db.LongText /// 项目/工作经验长文本
  raw_fragment          String?  @db.LongText /// 该人原文块
  structured_json       Json?    /// 其它键值、兜底
  /// 从切片 docx 拆出的内嵌图片绝对路径列表（JSON 数组，由 resume_split_extract 写入）
  education_cert_image_paths Json? /// 学历/学位证书等截图路径
  work_proof_image_paths     Json? /// 项目经验证明、工作履历承诺等截图路径
  other_image_paths          Json? /// 未归类图片路径
  created_at            DateTime @default(now())

  bid_resume_records                   bid_resume_records?                   @relation(fields: [resume_record_id], references: [id], onDelete: Cascade)
  bid_resume_person_canonical_sources bid_resume_person_canonical_source[]

  @@index([resume_record_id], map: "idx_bidresperson_parent")
  @@index([run_batch_id], map: "idx_bidresperson_batch")
  @@index([person_name], map: "idx_bidresperson_name")
  @@index([source_docx_modified_at], map: "idx_bidresperson_src_mtime")
  @@index([person_name, source_docx_modified_at], map: "idx_bidresperson_name_mtime")
  @@index([created_at], map: "idx_bidresperson_created")
}

/// 跨历史 bid_resume_persons 去重后的「自然人主档」：以 source_docx_modified_at 最新为主行，其余行按时间补空字段
model bid_resume_person_canonical {
  id               String   @id @db.VarChar(50)
  /// 聚类键：idc:… / ph:… / nm:… / solo:…
  merge_key        String   @unique @db.VarChar(200)
  merge_key_type   String   @db.VarChar(24) /// id_card | phone | person_name | solo
  resume_record_id String?  @db.VarChar(50)
  run_batch_id     String?  @db.VarChar(50)
  source_docx_basename String   @db.VarChar(255)
  source_docx_modified_at DateTime?
  h1_section_title String   @db.VarChar(500)
  l2_section_title String?  @db.VarChar(500)
  sort_order       Int      @default(0)
  role_label       String?  @db.VarChar(120)
  person_name      String?  @db.VarChar(80)
  gender           String?  @db.VarChar(20)
  age              String?  @db.VarChar(32)
  education_level  String?  @db.VarChar(80)
  major            String?  @db.VarChar(200)
  graduate_school  String?  @db.VarChar(200)
  work_years_hint  String?  @db.VarChar(64)
  work_duration_text String? @db.VarChar(64)
  phone            String?  @db.VarChar(50)
  email            String?  @db.VarChar(120)
  id_card          String?  @db.VarChar(24)
  degree           String?  @db.VarChar(40)
  employer         String?  @db.VarChar(200)
  proposed_project_role String? @db.VarChar(120)
  project_experience    String? @db.LongText
  raw_fragment          String? @db.LongText
  /// 由 AI 从 raw_fragment 提炼的专业技能（条列/段落）
  ai_professional_skills String? @db.LongText
  /// 由 AI 从 raw_fragment 提炼的工作履历（时间线/项目要点）
  ai_work_history        String? @db.LongText
  ai_enriched_at         DateTime?
  ai_enrichment_model    String? @db.VarChar(120)
  structured_json       Json?
  education_cert_image_paths Json?
  work_proof_image_paths     Json?
  other_image_paths          Json?
  /// 合并时 source_docx_modified_at 最大且作为主快照的那条 bid_resume_persons.id
  winning_person_id String  @db.VarChar(50)
  source_row_count  Int     @default(0)
  merged_at         DateTime @default(now())
  updated_at        DateTime @updatedAt

  bid_resume_records                 bid_resume_records?                 @relation(fields: [resume_record_id], references: [id], onDelete: SetNull)
  bid_resume_person_canonical_sources bid_resume_person_canonical_source[]

  @@index([merge_key_type], map: "idx_bidrescanon_keytype")
  @@index([person_name], map: "idx_bidrescanon_name")
  @@index([winning_person_id], map: "idx_bidrescanon_winner")
  @@index([resume_record_id], map: "idx_bidrescanon_resume_record")
}

/// canonical 与原始 bid_resume_persons 多对一溯源
model bid_resume_person_canonical_source {
  id                      String   @id @db.VarChar(50)
  canonical_id            String   @db.VarChar(50)
  person_id               String   @db.VarChar(50)
  source_docx_modified_at DateTime?
  created_at              DateTime @default(now())

  bid_resume_person_canonical bid_resume_person_canonical @relation(fields: [canonical_id], references: [id], onDelete: Cascade)
  bid_resume_persons          bid_resume_persons          @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([canonical_id, person_id], map: "uq_bidrescanonsrc_canon_person")
  @@index([person_id], map: "idx_bidrescanonsrc_person")
}

