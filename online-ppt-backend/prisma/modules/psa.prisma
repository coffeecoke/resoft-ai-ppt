// ==================== 数据库新增表（introspect 同步，仅追加） ====================

/// 企微视频H5模块配置与库表元信息
model psa_wec_config {
  id           BigInt    @id @default(autoincrement())
  config_key   String    @unique(map: "uk_psa_wec_config_key") @db.VarChar(128)
  config_value String?   @db.MediumText
  value_type   String    @default("string") @db.VarChar(32)
  description  String?   @db.VarChar(512)
  created_at   DateTime? @default(now()) @db.DateTime(0)
  updated_at   DateTime? @default(now()) @db.DateTime(0)
}

/// 企微用户表（从外部系统同步的用户信息）
model psa_wxwork_user {
  id             BigInt    @id @default(autoincrement())
  user_id        String    @unique(map: "user_id") @db.VarChar(64)
  name           String?   @db.VarChar(128)
  avatar         String?   @db.VarChar(512)
  email          String?   @db.VarChar(128)
  mobile         String?   @db.VarChar(32)
  department     String?   @db.VarChar(128)
  first_login_at DateTime? @db.DateTime(0)
  last_login_at  DateTime? @db.DateTime(0)
  extra_data     String?   @db.Text
  created_at     DateTime? @default(now()) @db.DateTime(0)
  updated_at     DateTime? @default(now()) @db.DateTime(0)

  @@index([last_login_at], map: "idx_psa_wxwork_user_last_login")
  @@index([user_id], map: "idx_psa_wxwork_user_user_id")
}

/// 视频播放心跳表（记录用户观看视频的心跳数据）
model psv_playback_heartbeat {
  id                BigInt    @id @default(autoincrement())
  user_id           String    @db.VarChar(64)
  video_id          String    @db.VarChar(64)
  chat_id           String?   @db.VarChar(64)
  session_id        String?   @db.VarChar(64)
  playback_position Decimal   @db.Decimal(10, 3)
  playback_duration Decimal   @default(0.000) @db.Decimal(10, 3)
  client_ip         String?   @db.VarChar(45)
  user_agent        String?   @db.Text
  device_info       String?   @db.Text
  extra_data        String?   @db.Text
  created_at        DateTime? @default(now()) @db.DateTime(0)

  @@index([created_at], map: "idx_heartbeat_created")
  @@index([session_id], map: "idx_heartbeat_session")
  @@index([user_id, video_id], map: "idx_heartbeat_user_video")
}

/// 视频播放汇总表（定期汇总用户观看视频的统计数据）
model psv_playback_summary {
  id                   BigInt    @id @default(autoincrement())
  user_id              String    @db.VarChar(64)
  video_id             String    @db.VarChar(64)
  chat_id              String?   @db.VarChar(64)
  total_watch_duration Decimal?  @default(0.000) @db.Decimal(10, 3)
  max_position         Decimal?  @default(0.000) @db.Decimal(10, 3)
  is_completed         Boolean?  @default(false)
  completed_at         DateTime? @db.DateTime(0)
  watch_count          Int?      @default(1)
  last_heartbeat_at    DateTime? @db.DateTime(0)
  last_position        Decimal?  @db.Decimal(10, 3)
  last_timestamp       BigInt?
  extra_data           String?   @db.Text
  created_at           DateTime? @default(now()) @db.DateTime(0)
  updated_at           DateTime? @default(now()) @db.DateTime(0)

  @@unique([user_id, video_id], map: "uk_user_video")
  @@index([chat_id], map: "idx_summary_chat")
  @@index([updated_at], map: "idx_summary_updated")
}

/// 用户统计表（记录用户的观看行为和统计数据）
model psv_user_statistics {
  id                    BigInt    @id @default(autoincrement())
  user_id               String    @unique(map: "user_id") @db.VarChar(64)
  total_watch_duration  Decimal?  @default(0.000) @db.Decimal(12, 3)
  video_count           Int?      @default(0)
  completed_video_count Int?      @default(0)
  avg_watch_time        Decimal?  @default(0.000) @db.Decimal(10, 3)
  daily_rank            Int?
  weekly_rank           Int?
  monthly_rank          Int?
  extra_data            String?   @db.Text
  created_at            DateTime? @default(now()) @db.DateTime(0)
  updated_at            DateTime? @default(now()) @db.DateTime(0)

  @@index([updated_at], map: "idx_statistics_updated")
}

/// 视频信息表（存储视频的元信息）
model psv_video_info {
  id          String    @id @db.VarChar(64)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  url         String    @db.VarChar(512)
  cover       String?   @db.VarChar(512)
  duration    Decimal?  @db.Decimal(10, 2)
  category    String?   @db.VarChar(64)
  tags        String?   @db.Text
  extra_data  String?   @db.Text
  created_at  DateTime? @default(now()) @db.DateTime(0)
  updated_at  DateTime? @default(now()) @db.DateTime(0)

  @@index([category], map: "idx_video_category")
  @@index([created_at], map: "idx_video_created")
}

/// 视频播放历史表（记录用户每次观看视频的历史数据）
model psv_watch_history {
  id                   BigInt    @id @default(autoincrement())
  user_id              String    @db.VarChar(64)
  video_id             String    @db.VarChar(64)
  chat_id              String?   @db.VarChar(64)
  total_watch_duration Decimal?  @default(0.000) @db.Decimal(10, 3)
  max_position         Decimal?  @default(0.000) @db.Decimal(10, 3)
  video_duration       Decimal?  @db.Decimal(10, 3)
  is_completed         Boolean?  @default(false)
  watch_count          Int?      @default(1)
  progress_percent     Decimal?  @default(0.00) @db.Decimal(5, 2)
  last_watched_at      DateTime? @db.DateTime(0)
  extra_data           String?   @db.Text
  created_at           DateTime? @default(now()) @db.DateTime(0)
  updated_at           DateTime? @default(now()) @db.DateTime(0)

  @@index([last_watched_at], map: "idx_history_last_watched")
  @@index([user_id], map: "idx_history_user")
  @@index([video_id], map: "idx_history_video")
}
