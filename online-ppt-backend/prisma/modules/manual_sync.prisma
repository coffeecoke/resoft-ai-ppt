/// 手工建表同步：CRM 报告附件
model crm_report_file {
  id                 BigInt   @id @default(autoincrement())
  report_id          String   @db.VarChar(50)
  msg_id             String?  @db.VarChar(100)
  from_user          String?  @db.VarChar(100)
  file_type          String?  @db.VarChar(20)
  original_file_name String?  @db.VarChar(255)
  local_file_path    String?  @db.VarChar(500)
  download_url       String?  @db.VarChar(500)
  file_seq           Int?     @default(1) @db.SmallInt
  created_at         DateTime @default(now())

  @@index([from_user], map: "idx_crm_rf_from_user")
  @@index([msg_id], map: "idx_crm_rf_msg_id")
  @@index([report_id], map: "idx_crm_rf_report_id")
}

/// 手工建表同步：日志同步状态
model log_sync_status {
  id            BigInt   @id @default(autoincrement())
  sync_type     String   @db.VarChar(50)
  batch_id      String   @unique(map: "uk_batch_id") @db.VarChar(50)
  sync_params   Json?
  start_time    DateTime
  end_time      DateTime?
  status        String   @default("running") @db.VarChar(20)
  stats_total   Int?     @default(0)
  stats_new     Int?     @default(0)
  stats_updated Int?     @default(0)
  stats_deleted Int?     @default(0)
  stats_errors  Int?     @default(0)
  error_message String?  @db.Text
  created_at    DateTime @default(now())

  @@index([start_time], map: "idx_start_time")
  @@index([status], map: "idx_status")
  @@index([sync_type], map: "idx_sync_type")
}

/// 手工建表同步：原始消息报告信息
model msg_raw_report_info {
  id                BigInt   @id @default(autoincrement())
  msg_id            String   @unique(map: "uk_msg_id") @db.VarChar(100)
  from_user         String   @db.VarChar(100)
  msg_datetime      DateTime
  msg_type          String   @db.VarChar(20)
  content           String?  @db.Text
  file_path         String?  @db.VarChar(500)
  file_name         String?  @db.VarChar(255)
  raw_json          Json?
  sync_batch_id     String?  @db.VarChar(50)
  is_processed      Boolean  @default(false)
  processed_at      DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())
  file_match_status Int?     @default(0) @db.SmallInt
  matched_report_id String?  @db.VarChar(50)

  @@index([from_user], map: "idx_from_user")
  @@index([is_processed], map: "idx_is_processed")
  @@index([msg_datetime], map: "idx_msg_datetime")
  @@index([file_match_status], map: "idx_msg_raw_file_match_status")
  @@index([matched_report_id], map: "idx_msg_raw_matched_report_id")
  @@index([sync_batch_id], map: "idx_sync_batch")
}

/// 手工建表同步：组织用户
model org_user {
  id            BigInt   @id @default(autoincrement())
  user_id       String   @unique(map: "uk_user_id") @db.VarChar(100)
  user_account  String?  @db.VarChar(100)
  user_name     String?  @db.VarChar(100)
  org_id        String?  @db.VarChar(100)
  org_name      String?  @db.VarChar(255)
  leader_id     String?  @db.VarChar(100)
  leader_name   String?  @db.VarChar(100)
  is_deleted    Boolean  @default(false)
  sync_batch_id String?  @db.VarChar(50)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  @@index([is_deleted], map: "idx_is_deleted")
  @@index([leader_id], map: "idx_leader_id")
  @@index([org_id], map: "idx_org_id")
  @@index([user_account], map: "idx_user_account")
}
