// ==================== 语音转录相关表 ====================

/// 语音转录记录表
model transcriptions {
  // 基础信息
  id                 String @id @db.VarChar(50) /// 转录ID
  name               String @db.VarChar(255) /// 音频文件名称（用户可编辑）
  original_file_name String @db.VarChar(255) /// 原始音频文件名

  // 文件信息
  audio_file_path String @db.VarChar(500) /// 音频文件存储路径
  audio_file_size BigInt @default(0) /// 音频文件大小（字节）
  audio_format    String @db.VarChar(20) /// 音频格式（mp3, wav, m4a等）
  audio_duration  Int? /// 音频时长（秒）

  // 转录结果
  result_file_path String? @db.VarChar(500) /// 转录结果文件路径
  dialogues        String? @db.LongText /// 对话列表（JSON数组）
  full_text        String? @db.LongText /// 完整文本内容（用于搜索）

  // 讯飞API相关
  xfyun_order_id      String? @db.VarChar(100) /// 讯飞订单ID
  speaker_count       Int     @default(0) /// 说话人数量
  has_role_separation Boolean @default(true) /// 是否启用角色分离
  speaker_roles       String? @db.LongText /// 说话人角色设置（JSON格式：{"SPEAKER_1": "customer", "SPEAKER_2": "our_side"}）

  // 业务关联
  session_id    String? @db.VarChar(50) /// 关联交流场次ID（可选）
  report_id     String? @db.VarChar(50) /// 关联交流报备ID（communication_reports.id，可选）
  product_id    String? @db.VarChar(50) /// 关联产品ID（可选）
  product_code  String? @db.VarChar(50) /// 产品代码（冗余存储，便于查询）
  product_name  String  @default("一表通") @db.VarChar(100) /// 产品名称（冗余存储，默认一表通）
  customer_name String? @db.VarChar(255) /// 客户名称
  industry      String? @db.VarChar(50) /// 行业（中文，如城商行、农商）
  meeting_type  String? @db.VarChar(50) /// 会议类型（中文，如首次交流、需求调研）
  customer_type String? @db.VarChar(50) /// 客户类型（中文，如新客户新产品）
  audience      String? @db.VarChar(50) /// 交流对象（中文，如业务、科技）
  language      String? @db.VarChar(20) /// 语言（中文、英文）

  // 状态管理
  status        String  @default("pending") @db.VarChar(20) /// 状态：pending=待处理，uploading=上传中，processing=转录中，completed=已完成，failed=失败
  error_message String? @db.LongText /// 错误信息（失败时记录）
  progress      Int     @default(0) /// 进度（0-100）

  // 时间戳
  created_by   String?   @db.VarChar(50) /// 创建人用户ID
  created_at   DateTime  @default(now()) /// 创建时间
  updated_at   DateTime  @updatedAt /// 更新时间
  completed_at DateTime? /// 完成时间

  // 关联
  sessions                    sessions?                    @relation(fields: [session_id], references: [id])
  products                    products?                    @relation(fields: [product_id], references: [id])
  dialogue_adjustments        dialogue_adjustments[]       /// 对话调整记录
  presales_analysis_results   presales_analysis_results[]  /// 售前交流综合分析结果
  presales_video_tasks        presales_video_tasks?        /// 售前视频生成主任务（每条转录最多一条）
  presales_video_pipeline_runs presales_video_pipeline_runs[] /// 服务端自动流水线运行记录（方案 B）

  @@index([status], map: "idx_status")
  @@index([session_id], map: "idx_session_id")
  @@index([report_id], map: "idx_transcription_report_id")
  @@index([product_id], map: "idx_product_id")
  @@index([customer_name], map: "idx_customer_name")
  @@index([created_at], map: "idx_created_at")
  @@index([industry], map: "idx_industry")
  @@index([meeting_type], map: "idx_meeting_type")
  @@index([customer_type], map: "idx_customer_type")
  @@index([audience], map: "idx_audience")
  @@index([language], map: "idx_language")
  @@index([created_by], map: "idx_transcription_created_by")
  @@fulltext([full_text], map: "ft_full_text")
}

/// 售前分析·视频生成主任务（Coze 上传 file_id/file_name、工作流 execute_id、流水线状态落库）
model presales_video_tasks {
  id               String @id @db.VarChar(50) /// 主任务 ID（UUID）
  transcription_id String @unique @db.VarChar(50) /// 关联转录（一条转录对应一条主任务记录）

  /// Coze 文件上传（字段 file）返回
  coze_file_id   String? @db.VarChar(200)
  coze_file_name String? @db.VarChar(500)
  /// 待推送的合并对话 txt 本地路径
  local_dialogue_txt_path String? @db.VarChar(1000)
  /// Coze meeting-analysis 返回
  execute_id String? @db.VarChar(200)

  /// 流水线状态：角色确认中 | 角色已确认 | 推送对话 | 提交工作流 | 分析中 | 分析完成 | 推送分析文件 | 视频生成 等
  pipeline_status String @default("推送对话") @db.VarChar(32)

  analysis_content String? @db.LongText /// 分析完内容（约 2 万字量级，LONGTEXT）
  video_address    String? @db.VarChar(2000) /// 视频地址（URL 或服务器路径）
  reserve_3        String? @db.VarChar(500) /// 售前视频：analysis_content 成功落盘 .md 的路径（最长 500，超出截断）
  reserve_4 String? @db.VarChar(500) /// 备用
  reserve_5 String? @db.VarChar(500) /// 播放列表等（workflow-callback video_create 可选 playlist_url，最长 500）

  last_error String? @db.VarChar(2000) /// 最近一步错误摘要

  /// 角色确认卡片接收人企微 userid（用于超时提醒）
  role_confirm_wecom_userid String? @db.VarChar(100)
  /// 最近一次发出角色确认卡片的时间（超时提醒计时起点）
  role_confirm_card_sent_at DateTime?
  /// 最近一次「尽快确认」提醒发送时间（按间隔重复提醒，直至离开角色确认中；重新发卡片会清空）
  role_confirm_reminder_sent_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transcription transcriptions @relation(fields: [transcription_id], references: [id], onDelete: Cascade)

  @@index([pipeline_status], map: "idx_pv_video_task_status")
  @@index([updated_at], map: "idx_pv_video_task_updated")
  @@index([pipeline_status, role_confirm_reminder_sent_at], map: "idx_pv_role_confirm_remind")
}

/// 售前视频 · 服务端自动流水线（不依赖浏览器；定时轮询 + 回调唤醒）
model presales_video_pipeline_runs {
  id                    String   @id @db.VarChar(50)
  transcription_id      String   @db.VarChar(50)
  /// active | completed | failed
  run_status            String   @default("active") @db.VarChar(20)
  /// init | wait_speaker | push_dialogue | submit_workflow | wait_analysis | push_report | wait_video | push_video | superseded
  phase                 String   @default("init") @db.VarChar(32)
  wecom_user_id         String?  @db.VarChar(100)
  /// 推送视频：企微 userid 逗号分隔（至少 2 人规则仍由 push-video 接口校验）
  push_video_user_ids   String?  @db.VarChar(2000)
  skip_role_confirm     Boolean  @default(false)
  last_error            String?  @db.VarChar(2000)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  transcription transcriptions @relation(fields: [transcription_id], references: [id], onDelete: Cascade)

  @@index([run_status, updated_at], map: "idx_pv_pipe_run_status")
  @@index([transcription_id, run_status], map: "idx_pv_pipe_tid_status")
}

/// 对话调整记录表（用于多次调整对话内容）
model dialogue_adjustments {
  // 基础信息
  id               String @id @db.VarChar(50) /// 调整记录ID
  transcription_id String @db.VarChar(50) /// 关联的转录ID

  // 基础信息（从transcription复制）
  name               String @db.VarChar(255) /// 音频文件名称
  original_file_name String @db.VarChar(255) /// 原始音频文件名

  // 文件信息
  audio_file_path String @db.VarChar(500) /// 音频文件存储路径
  audio_file_size BigInt @default(0) /// 音频文件大小（字节）
  audio_format    String @db.VarChar(20) /// 音频格式
  audio_duration  Int? /// 音频时长（秒）

  // 调整后的对话结果
  adjusted_dialogues String? @db.LongText /// 调整后的对话列表（JSON数组）
  full_text          String? @db.LongText /// 完整文本内容（用于搜索）

  // 讯飞API相关
  xfyun_order_id      String? @db.VarChar(100) /// 讯飞订单ID
  speaker_count       Int     @default(0) /// 说话人数量
  has_role_separation Boolean @default(true) /// 是否启用角色分离
  speaker_roles       String? @db.LongText /// 说话人角色设置

  // 业务关联
  session_id    String? @db.VarChar(50) /// 关联交流场次ID
  product_id    String? @db.VarChar(50) /// 关联产品ID
  customer_name String? @db.VarChar(255) /// 客户名称

  // 备注字段（用于记录调整原因、说明等）
  note1 String? @db.Text /// 备注1
  note2 String? @db.Text /// 备注2

  // 时间戳
  created_at DateTime @default(now()) /// 创建时间
  updated_at DateTime @updatedAt /// 更新时间

  // 关联
  transcription transcriptions @relation(fields: [transcription_id], references: [id], onDelete: Cascade)
  sessions      sessions?      @relation(fields: [session_id], references: [id])
  products      products?      @relation(fields: [product_id], references: [id])

  @@index([transcription_id], map: "idx_adjustment_transcription_id")
  @@index([created_at], map: "idx_adjustment_created_at")
  @@fulltext([full_text], map: "ft_adjustment_full_text")
}

// ==================== 售前交流综合分析相关表 ====================

/// 售前交流综合分析结果表
model presales_analysis_results {
  // 基础信息
  id              String  @id @db.VarChar(50) /// 分析结果ID
  transcription_id String  @db.VarChar(50)    /// 关联的转录ID

  // 分析配置
  model_id   String? @db.VarChar(50)  /// 使用的模型ID
  model_name String? @db.VarChar(100) /// 使用的模型名称
  prompt_code String? @db.VarChar(100) /// 使用的提示词代码
  prompt_name String? @db.VarChar(100) /// 使用的提示词名称

  // 分析结果（JSON格式）
  analysis_result String @db.LongText /// 分析结果（JSON格式）

  // 元数据
  dialogue_count Int     @default(0) /// 对话数量
  analysis_time  Int?    /// 分析耗时（毫秒）
  confidence     Decimal? @db.Decimal(3, 2) /// 置信度（0-1）

  // 状态
  status       String  @default("completed") @db.VarChar(20) /// 状态：completed=已完成，failed=失败
  error_message String? @db.Text /// 错误信息（失败时）

  // 时间戳
  created_at DateTime @default(now()) /// 创建时间
  updated_at DateTime @updatedAt       /// 更新时间

  // 关联
  transcription transcriptions @relation(fields: [transcription_id], references: [id], onDelete: Cascade)

  @@index([transcription_id], map: "idx_presales_analysis_transcription_id")
  @@index([created_at], map: "idx_presales_analysis_created_at")
  @@index([status], map: "idx_presales_analysis_status")
}
