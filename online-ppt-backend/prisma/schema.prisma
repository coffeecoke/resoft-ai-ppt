// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// PPT文档表
model Document {
  // 基础信息
  id                    String   @id @db.VarChar(50)                                /// 文档ID
  name                  String   @db.VarChar(255)                                   /// 文档名称
  cover                 String?  @db.VarChar(500)                                   /// 封面图URL
  category              String   @default("uncategorized") @db.VarChar(50)          /// 分类
  status                String   @default("draft") @db.VarChar(20)                  /// 状态：draft=草稿，published=已发布
  tag                   String   @default("public") @db.VarChar(20)                 /// 标签：public=公共版，practical=实战版
  
  // 文件信息
  contentFilePath       String   @map("content_file_path") @db.VarChar(500)         /// 内容文件路径
  slideCount            Int      @default(0) @map("slide_count")                    /// 幻灯片数量
  fileSize              BigInt   @default(0) @map("file_size")                      /// 文件大小（字节）
  
  // 业务字段
  customerName          String?  @map("customer_name") @db.VarChar(255)             /// 客户名称
  product               Json?                                                       /// 产品（数组，兼容旧数据）
  industry              Json?                                                       /// 行业（数组）
  audience              Json?                                                       /// 受众（数组）
  language              String?  @db.VarChar(50)                                    /// 语言
  
  // 🆕 回传PPT相关字段
  productId             String?  @map("product_id") @db.VarChar(50)                 /// 关联产品ID（回传时选择）
  sessionId             String?  @map("session_id") @db.VarChar(50)                 /// 关联交流场次ID
  
  // 溯源字段
  sourceDocumentId      String?  @map("source_document_id") @db.VarChar(50)         /// 源文档ID
  sourceDocumentName    String?  @map("source_document_name") @db.VarChar(255)      /// 源文档名称
  
  // 时间戳
  createdAt             DateTime @default(now()) @map("created_at")                 /// 创建时间
  updatedAt             DateTime @updatedAt @map("updated_at")                      /// 更新时间
  lastOpenedAt          DateTime? @map("last_opened_at")                            /// 最后打开时间
  
  // 关联
  productRelation       Product? @relation("DocumentProduct", fields: [productId], references: [id], onDelete: SetNull)
  sessionRelation       Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  productDocuments      ProductDocument[]
  concerns              DocumentConcern[]
  thumbnails            Thumbnail[]
  
  @@index([status], map: "idx_status")
  @@index([category], map: "idx_category")
  @@index([createdAt], map: "idx_created_at")
  @@index([customerName], map: "idx_customer")
  @@index([productId], map: "idx_product_id")
  @@index([sessionId], map: "idx_session_id")
  @@map("documents")
}

/// 缩略图表
model Thumbnail {
  // 主键
  id                String   @id @db.VarChar(100)                                   /// 缩略图ID
  
  // 关联字段
  documentId        String   @map("document_id") @db.VarChar(50)                    /// 文档ID
  slideId           String   @map("slide_id") @db.VarChar(50)                       /// 幻灯片ID
  slideIndex        Int      @map("slide_index")                                    /// 幻灯片索引（从0开始）
  
  // 缩略图信息
  url               String   @db.VarChar(500)                                       /// 缩略图URL
  width             Int      @default(800)                                          /// 宽度（像素）
  height            Int      @default(450)                                          /// 高度（像素）
  size              Int?                                                            /// 文件大小（字节）
  format            String   @default("jpeg") @db.VarChar(20)                       /// 图片格式
  
  // 元数据
  hasText           Boolean  @default(false) @map("has_text")                       /// 是否包含文本
  hasImage          Boolean  @default(false) @map("has_image")                      /// 是否包含图片
  elementCount      Int      @default(0) @map("element_count")                      /// 元素数量
  
  // 🆕 AI分析的页面类型标签
  pageType          String?  @map("page_type") @db.VarChar(100)                     /// AI分析的页面类型（如"产品简介"）
  pageTypeConfidence Float?  @map("page_type_confidence")                           /// AI分析置信度（0-1）
  analyzedAt        DateTime? @map("analyzed_at")                                   /// AI分析时间
  
  // 时间戳
  generatedAt       DateTime @default(now()) @map("generated_at")                   /// 生成时间
  
  // 关联
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@unique([documentId, slideId], map: "uk_document_slide")
  @@index([documentId], map: "idx_document_id")
  @@index([slideId], map: "idx_slide_id")
  @@index([slideIndex], map: "idx_slide_index")
  @@index([pageType], map: "idx_page_type")
  @@map("thumbnails")
}

// ==================== 产品管理相关表 ====================

/// 产品表
model Product {
  id              String   @id @default(uuid()) @db.VarChar(50)                     /// 产品ID
  name            String   @db.VarChar(255)                                         /// 产品名称
  code            String?  @unique @db.VarChar(100)                                 /// 产品代码（唯一，用于回传时选择）
  description     String?  @db.Text                                                 /// 产品描述
  category        String?  @db.VarChar(50)                                          /// 产品分类
  tags            Json?                                                             /// 产品标签（数组）
  icon            String?  @db.VarChar(500)                                         /// 产品图标URL
  cover           String?  @db.VarChar(500)                                         /// 产品封面图URL
  sortOrder       Int      @default(0) @map("sort_order")                           /// 排序字段
  isActive        Boolean  @default(true) @map("is_active")                         /// 是否启用
  createdAt       DateTime @default(now()) @map("created_at")                       /// 创建时间
  updatedAt       DateTime @updatedAt @map("updated_at")                            /// 更新时间
  
  // 关联
  catalogs        ProductCatalog[]
  productDocuments ProductDocument[]
  documents       Document[] @relation("DocumentProduct")
  sessions        Session[]
  pageTypeMappings PageTypeCatalogMapping[]
  
  @@index([category], map: "idx_category")
  @@index([isActive], map: "idx_is_active")
  @@index([sortOrder], map: "idx_sort_order")
  @@map("products")
}

/// 产品目录表（固定的标准目录结构）
model ProductCatalog {
  id              String   @id @default(uuid()) @db.VarChar(50)                     /// 目录ID
  productId       String   @map("product_id") @db.VarChar(50)                       /// 关联产品ID
  parentId        String?  @map("parent_id") @db.VarChar(50)                        /// 父目录ID（支持层级）
  name            String   @db.VarChar(255)                                         /// 目录名称
  code            String?  @db.VarChar(100)                                         /// 目录代码（如"1.1"、"1.2"）
  description     String?  @db.Text                                                 /// 目录描述
  sortOrder       Int      @default(0) @map("sort_order")                           /// 排序字段
  level           Int      @default(1)                                              /// 层级（1=一级，2=二级）
  isActive        Boolean  @default(true) @map("is_active")                         /// 是否启用
  createdAt       DateTime @default(now()) @map("created_at")                       /// 创建时间
  updatedAt       DateTime @updatedAt @map("updated_at")                            /// 更新时间
  
  // 关联
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent          ProductCatalog? @relation("CatalogHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        ProductCatalog[] @relation("CatalogHierarchy")
  documents       ProductDocument[]
  pageTypeMappings PageTypeCatalogMapping[]
  
  @@index([productId], map: "idx_product_id")
  @@index([parentId], map: "idx_parent_id")
  @@index([level], map: "idx_level")
  @@map("product_catalogs")
}

/// 产品文档关联表（用于产品介绍PPT的目录展示）
model ProductDocument {
  id              String   @id @default(uuid()) @db.VarChar(50)                     /// 关联ID
  productId       String   @map("product_id") @db.VarChar(50)                       /// 产品ID
  documentId      String   @map("document_id") @db.VarChar(50)                      /// 文档ID
  catalogId       String?  @map("catalog_id") @db.VarChar(50)                       /// 目录ID（二级目录）
  version         String   @default("public") @db.VarChar(20)                       /// 版本：public=公共版，practical=实战版
  slidePages      Json?    @map("slide_pages")                                      /// 页码数组 [1,3,5,7] 或 null=未指定
  sortOrder       Int      @default(0) @map("sort_order")                           /// 排序字段
  createdAt       DateTime @default(now()) @map("created_at")                       /// 创建时间
  updatedAt       DateTime @updatedAt @map("updated_at")                            /// 更新时间
  
  // 关联
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  catalog         ProductCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  
  @@unique([productId, documentId, catalogId], map: "uk_product_document_catalog")
  @@index([productId], map: "idx_product_id")
  @@index([documentId], map: "idx_document_id")
  @@index([catalogId], map: "idx_catalog_id")
  @@index([version], map: "idx_version")
  @@map("product_documents")
}

/// 页面类型与目录映射表（AI页面类型到产品目录的映射）
model PageTypeCatalogMapping {
  id              String   @id @default(uuid()) @db.VarChar(50)                     /// 映射ID
  productId       String   @map("product_id") @db.VarChar(50)                       /// 产品ID
  catalogId       String   @map("catalog_id") @db.VarChar(50)                       /// 目录ID
  pageType        String   @map("page_type") @db.VarChar(100)                       /// AI分析的页面类型（如"产品简介"）
  isActive        Boolean  @default(true) @map("is_active")                         /// 是否启用
  createdAt       DateTime @default(now()) @map("created_at")                       /// 创建时间
  updatedAt       DateTime @updatedAt @map("updated_at")                            /// 更新时间
  
  // 关联
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalog         ProductCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  
  @@unique([productId, catalogId, pageType], map: "uk_product_catalog_page_type")
  @@index([productId], map: "idx_product_id")
  @@index([catalogId], map: "idx_catalog_id")
  @@index([pageType], map: "idx_page_type")
  @@map("page_type_catalog_mappings")
}

// ==================== 交流场次相关表 ====================

/// 交流场次表（客户交流会议信息）
model Session {
  id              String   @id @default(uuid()) @db.VarChar(50)                     /// 场次ID
  title           String   @db.VarChar(255)                                         /// 会议主题
  customerName    String   @map("customer_name") @db.VarChar(255)                   /// 客户名称
  sessionDate     DateTime @map("session_date")                                     /// 会议时间
  duration        Int?                                                              /// 会议时长（分钟）
  location        String?  @db.VarChar(255)                                         /// 会议地点
  videoUrl        String?  @map("video_url") @db.VarChar(500)                       /// 视频录像URL
  thumbnail       String?  @db.VarChar(500)                                         /// 视频缩略图URL
  participants    Json?                                                             /// 参与人员（数组）
  productId       String?  @map("product_id") @db.VarChar(50)                       /// 主要讨论的产品ID
  industry        Json?                                                             /// 行业（数组）
  status          String   @default("draft") @db.VarChar(20)                        /// 状态：draft=草稿，completed=已完成
  createdAt       DateTime @default(now()) @map("created_at")                       /// 创建时间
  updatedAt       DateTime @updatedAt @map("updated_at")                            /// 更新时间
  createdBy       String?  @map("created_by") @db.VarChar(50)                       /// 创建人ID
  
  // 关联
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  documents       Document[]
  concerns        SessionConcern[]
  needs           SessionNeed[]
  
  @@index([productId], map: "idx_product_id")
  @@index([customerName], map: "idx_customer_name")
  @@index([sessionDate], map: "idx_session_date")
  @@index([createdBy], map: "idx_created_by")
  @@map("sessions")
}

/// 关心的问题表
model Concern {
  id              String   @id @default(uuid()) @db.VarChar(50)                     /// 问题ID
  question        String   @db.Text                                                 /// 问题内容
  category        String?  @db.VarChar(100)                                         /// 问题分类
  priority        String?  @db.VarChar(20)                                          /// 优先级：high=高，medium=中，low=低
  answer          String?  @db.Text                                                 /// 回答内容
  status          String   @default("pending") @db.VarChar(20)                      /// 状态：pending=待回答，answered=已回答
  createdAt       DateTime @default(now()) @map("created_at")                       /// 创建时间
  updatedAt       DateTime @updatedAt @map("updated_at")                            /// 更新时间
  
  // 关联
  sessions        SessionConcern[]
  documents       DocumentConcern[]
  
  @@index([category], map: "idx_category")
  @@index([status], map: "idx_status")
  @@map("concerns")
}

/// 交流场次-关心问题关联表
model SessionConcern {
  id              String   @id @default(uuid()) @db.VarChar(50)                     /// 关联ID
  sessionId       String   @map("session_id") @db.VarChar(50)                       /// 场次ID
  concernId       String   @map("concern_id") @db.VarChar(50)                       /// 问题ID
  sortOrder       Int      @default(0) @map("sort_order")                           /// 排序字段
  createdAt       DateTime @default(now()) @map("created_at")                       /// 创建时间
  
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  concern         Concern  @relation(fields: [concernId], references: [id], onDelete: Cascade)
  
  @@unique([sessionId, concernId], map: "uk_session_concern")
  @@index([sessionId], map: "idx_session_id")
  @@index([concernId], map: "idx_concern_id")
  @@map("session_concerns")
}

/// 文档-关心问题关联表
model DocumentConcern {
  id              String   @id @default(uuid()) @db.VarChar(50)                     /// 关联ID
  documentId      String   @map("document_id") @db.VarChar(50)                      /// 文档ID
  concernId       String   @map("concern_id") @db.VarChar(50)                       /// 问题ID
  sortOrder       Int      @default(0) @map("sort_order")                           /// 排序字段
  createdAt       DateTime @default(now()) @map("created_at")                       /// 创建时间
  
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  concern         Concern  @relation(fields: [concernId], references: [id], onDelete: Cascade)
  
  @@unique([documentId, concernId], map: "uk_document_concern")
  @@index([documentId], map: "idx_document_id")
  @@index([concernId], map: "idx_concern_id")
  @@map("document_concerns")
}

/// 潜在需求表
model SessionNeed {
  id              String   @id @default(uuid()) @db.VarChar(50)                     /// 需求ID
  sessionId       String   @map("session_id") @db.VarChar(50)                       /// 场次ID
  need            String   @db.Text                                                 /// 需求内容
  priority        String?  @db.VarChar(20)                                          /// 优先级：high=高，medium=中，low=低
  status          String   @default("pending") @db.VarChar(20)                      /// 状态：pending=待确认，confirmed=已确认
  sortOrder       Int      @default(0) @map("sort_order")                           /// 排序字段
  createdAt       DateTime @default(now()) @map("created_at")                       /// 创建时间
  updatedAt       DateTime @updatedAt @map("updated_at")                            /// 更新时间
  
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([sessionId], map: "idx_session_id")
  @@map("session_needs")
}
