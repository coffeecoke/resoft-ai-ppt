# ============================================
# 服务配置
# ============================================

# 服务端口
PORT=5001

# ============================================
# 数据目录配置
# ============================================

# 数据文件存储路径（可选）
# 如果不设置，默认使用项目内的 data/ 目录
# Windows 示例：`n# DATA_DIR=D:\ppt-data
# Linux/Mac 示例：`n# DATA_DIR=/data/ppt-data
DATA_DIR=

# ========== OpenAI ==========
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# ========== 通义千问 (阿里�? ==========
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========== 智谱AI (GLM) ==========
ZHIPU_API_KEY=xxx.xxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ========== 豆包 (字节跳动) ==========
DOUBAO_API_KEY=149f6f78-2df2-409a-b819-44e4cad7b8ca
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ========== DeepSeek ==========
DEEPSEEK_API_KEY=sk-f9552e3468114a0998ecbd6297478478
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ========== 月之暗面 (Moonshot/Kimi) ==========
MOONSHOT_API_KEY=sk-xxx
