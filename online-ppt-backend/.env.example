# Unsplash 图片 API（二选一即可�?
UNSPLASH_ACCESS_KEY=你的Unsplash_Access_Key

# �?Pexels 图片 API
PEXELS_API_KEY=Q66p7lrT6kWiG0gNWYkJx0v3lBjFW3xdneDLYzFNA4tgSlx0e97cQxyh



# 数据库配�?
# 每个开发者复制此文件�?.env,并修改为自己的配�?

DATABASE_URL="mysql://aippt_user:your_password@localhost:3306/aippt_db"

# 迁移策略
USE_DATABASE=false          # 是否使用数据�?开发时可以先false)
DUAL_WRITE=false           # 是否双写(数据�?JSON)
KEEP_JSON_BACKUP=true      # 是否保留JSON备份
SHADOW_DATABASE_URL=mysql://aippt_user:your_password@localhost:3306/aippt_db_shadow

# 数据目录配置（可选）
# 如果不设置，默认使用项目内的 data/ 目录
# Windows 示例：
DATA_DIR=D:\ppt-data
# Linux/Mac 示例：
# DATA_DIR=/data/ppt-data
# ============================================
# 文件扫描配置
# ============================================

# 源目录路径（必填）`n# Windows 示例：FILE_SCAN_SOURCE_DIR=D:\pre-sales-source-data
# Linux/Mac 示例：FILE_SCAN_SOURCE_DIR=/data/pre-sales-source-data
# 是否启用定时扫描（默认：true）`nFILE_SCAN_ENABLED=true
# 扫描间隔（毫秒，默认�?600000，即1小时）`nFILE_SCAN_INTERVAL=3600000
# 是否自动处理新文件（默认：true）`nFILE_SCAN_AUTO_PROCESS=true
# 支持的文件类型（逗号分隔，默认：.pptx）`nFILE_SCAN_FILE_TYPES=.pptx,.docx,.pdf
# 文件类型到子目录的映射（可选）
# 格式pptx=ppt,.docx=docs,.pdf=pdf
# 如果配置了映射，系统会在源目录下查找对应的子目录
# 例如：FILE_SCAN_SOURCE_DIR=D:\pre-sales-source-data
#       FILE_SCAN_TYPE_DIRS=.pptx=ppt,.docx=docs
#       PPTX 文件会从 D:\pre-sales-source-data\ppt 目录扫描
#       DOCX 文件会从 D:\pre-sales-source-data\docs 目录扫描
FILE_SCAN_SOURCE_DIR=D:\pre-sales-source-data #源目录路径（必填）
FILE_SCAN_TYPE_DIRS=.pptx=ppt,.docx=docs,.pdf=pdf # 文件类型到子目录的映射, 格式pptx=ppt,.docx=docs,.pdf=pdf
FILE_SCAN_ENABLED=true #否启用定时扫描
FILE_SCAN_INTERVAL=3600000 #扫描间隔（毫秒，默认�?600000，即1小时）
FILE_SCAN_AUTO_PROCESS=true #是否自动处理扫描到的文件。true=自动处理新文件和已更新的文件；false=仅扫描不处理，需手动处理（默认：true）
FILE_SCAN_FILE_TYPES=pptx=.pptx,.docx,.pdf  #文件类型到子目录的映射（可选） 格式pptx=ppt,.docx=docs,.pdf=pdf
